{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "scripts/enrollment/macbook-readiness-policy.ts",
    "scripts/enrollment/v3-p03-real-mac-pending.ts",
    "scripts/acceptance/v3-p08-real-macbook.ts",
    "scripts/acceptance/v3-cross-device-consent-local.ts",
    "scripts/acceptance/v3-local-beta-gateway.ts",
    "scripts/operations/v3-beta-local-daemon.ts",
    "scripts/acceptance/v3-f01-fleet-local.ts",
    "scripts/operations/v3-oauth-readonly-daemon.ts",
    "scripts/operations/v3-oauth-approve.ts",
    "scripts/operations/v3-register-physical-pending.ts",
    "scripts/operations/v3-verify-mac-identity-proof.ts",
    "scripts/acceptance/v3-windows-protected-identity.ts",
    "scripts/operations/v3-owner-signing.ts",
    "scripts/operations/v3-owner-interactive-cycle.ts",
    "scripts/operations/v3-mac-operator-cycle.ts",
    "scripts/operations/v3-mac-fleet-cycle.ts",
    "scripts/operations/v3-windows-operator-cycle.ts",
    "scripts/operations/v3-windows-fleet-cycle.ts",
    "scripts/operations/v3-s03-mac-witness-daemon.ts",
    "scripts/operations/v3-windows-live-enrollment.ts",
    "scripts/operations/v3-windows-signed-heartbeat.ts",
    "scripts/operations/v3-physical-mac-proof-20261012.ts",
    "scripts/operations/v3-p03-mac-owner-stage-20261012.ts",
    "scripts/operations/v3-p03-mac-owner-admit-20261012.ts",
    "scripts/operations/v3-p03-mac-signed-heartbeat-20261012.ts",
    "scripts/acceptance/v3-windows-identity-negatives.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
