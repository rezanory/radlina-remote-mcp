<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.radlina.remote-mcp.v3-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_EXECUTABLE__</string>
    <string>__WATCHDOG_SCRIPT__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>RADLINA_WATCHDOG_REPOSITORY</key>
    <string>__REPOSITORY__</string>
    <key>RADLINA_WATCHDOG_STATE_DIRECTORY</key>
    <string>__STATE_DIRECTORY__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>/dev/null</string>
</dict>
</plist>
