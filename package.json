{
  "name": "radlina-remote-mcp",
  "version": "0.2.2",
  "private": true,
  "description": "Secure self-hosted Remote MCP server for a Windows workstation",
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "release:build": "node scripts/operations/build-release.mjs",
    "release:validate": "node scripts/operations/closure-validation.mjs",
    "release:drill": "node scripts/operations/isolated-upgrade-drill.mjs",
    "release:verify": "node scripts/operations/verify-release.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/src/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:resilience": "vitest run tests/resilience",
    "control": "node --enable-source-maps dist/src/cli/control.js",
    "config:public": "node --enable-source-maps dist/src/cli/configure-public-url.js",
    "diagnose": "node --enable-source-maps dist/src/cli/diagnose.js",
    "benchmark": "node --enable-source-maps dist/src/cli/benchmark.js",
    "audit:verify": "node --enable-source-maps dist/src/cli/control.js verify-audit",
    "security:audit": "npm audit --audit-level=high",
    "sbom": "cyclonedx-npm --output-file reports/PH-01/sbom.cdx.json --output-format JSON --spec-version 1.6",
    "licenses": "node scripts/operations/license-inventory.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@eslint/js": "9.39.5",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/inspector": "2.5.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  }
}
